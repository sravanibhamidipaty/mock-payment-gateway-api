# Copy this file to .env and fill in real values. Never commit .env.

# ---- API ----
API_KEY_SECRET=sk_test_changeme

# ---- Postgres ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=payment_db

# Connection string used when running on the host (mapped port 5433).
# Inside Docker, DATABASE_URL is built from the POSTGRES_* vars in docker-compose.yml.
DATABASE_URL_LOCAL=postgresql+asyncpg://admin:changeme@localhost:5433/payment_db

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
KAFKA_URL=kafka:9092

# ---- Worker / Notifier ----
NOTIFIER_URL=http://notifier:8001/webhook

# ---- AWS (Floci / LocalStack) ----
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---- Email (Notifier) ----
SENDER_EMAIL=you@example.com
RECEIVER_EMAIL=you@example.com
APP_PASSWORD=your_gmail_app_password
